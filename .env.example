# Cloud API configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bakealley
PORT=3000
NODE_ENV=development
APP_VERSION=0.1.0-cloud
# Used only by the one-time seed-admin command; never commit real values.
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_DISPLAY_NAME=Bake Alley Admin
CLOUD_ADMIN_PASSWORD=replace-with-a-strong-password
