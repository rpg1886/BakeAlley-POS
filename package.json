{
  "name": "bakealley-pos",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "cloud:start": "node server/app.js",
    "cloud:seed-admin": "node server/scripts/seed-admin.js",
    "cloud:import-local": "node server/scripts/import-local.js",
    "cloud:import-main-inventory": "node server/scripts/import-main-inventory.js",
    "cloud:build": "vite build --config web/vite.config.ts",
    "cloud:check": "node --check server/app.js && node --check server/auth.js && node --check server/db.js && node --check server/logger.js && node --check server/validation.js && node --check server/scripts/seed-admin.js && node --check server/scripts/import-main-inventory.js && node --check server/routes/sync.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "repomix": "^1.18.1",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^12.4.1",
    "electron": "^44.4.5",
    "serialport": "^13.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  }
}
