lassName="w-full text-left text-sm"><thead className="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th className="px-5 py-3">Employee</th><th className="px-3 py-3">Access role</th><th className="px-3 py-3">Current shift</th>{role==='admin'&&<th className="px-3 py-3 text-right">Sales amount</th>}<th className="px-3 py-3 text-right">Sales count</th><th><span className="sr-only">Action</span></th></tr></thead><tbody>{employees.map((employee)=><tr className="border-t border-slate-100" key={employee.userId}><td className="px-5 py-4"><strong>{employee.displayName}</strong><div className="text-xs text-slate-500">{employee.username}</div></td><td className="px-3 py-4 capitalize">{employee.role}</td><td className="px-3 py-4">{employee.openShiftStart?`Clocked in ${new Date(employee.openShiftStart).toLocaleTimeString()}`:'Off shift'}</td>{role==='admin'&&<td className="px-3 py-4 text-right">${employee.salesTotal.toFixed(2)}</td>}<td className="px-3 py-4 text-right">{employee.salesCount}</td><td className="pr-5 text-right"><button className="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold" type="button" onClick={()=>void toggleShift(employee)}>{employee.openShiftStart?'Clock out':'Clock in'}</button></td></tr>)}</tbody></table></div></div>{role==='admin'&&<div className="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div className="flex flex-wrap items-end justify-between gap-3"><div><h2 className="font-semibold">Shift calendar</h2><p className="text-sm text-slate-500">Clock-in and clock-out records for the selected day.</p></div><input className="rounded-lg border border-slate-300 px-3 py-2" type="date" value={selectedDate} onChange={(event)=>setSelectedDate(event.target.value)}/></div><div className="mt-4 overflow-x-auto"><table className="w-full text-left text-sm"><thead className="text-xs uppercase tracking-wide text-slate-500"><tr><th className="py-3">Employee</th><th className="py-3">Role</th><th className="py-3">Clock in</th><th className="py-3">Clock out</th></tr></thead><tbody>{shiftRows.map((shift)=><tr className="border-t border-slate-100" key={`${shift.userId}-${shift.clockIn}`}><td className="py-3">{shift.displayName}</td><td className="py-3 capitalize">{shift.role}</td><td className="py-3">{new Date(shift.clockIn).toLocaleTimeString()}</td><td className="py-3">{shift.clockOut?new Date(shift.clockOut).toLocaleTimeString():'Still clocked in'}</td></tr>)}</tbody></table></div></div>}</div></section>;
