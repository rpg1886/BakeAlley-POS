import Database from 'better-sqlite3';
import type { AuthService } from '../auth/authService';

export interface SalesItemSummary {
    orderId: string;
    soldAt: string;
    customerName: string;
    sku: string;
    itemName: string;
    quantity: number;
    amount: number;
    paymentMethod: 'cash' | 'card' | 'account';
