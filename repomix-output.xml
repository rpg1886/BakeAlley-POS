console.log('');

// TEST 2: Zod Schema Validation
log('TEST 2: Zod Schema Validation', 'info');

const { validate, loginSchema, customerSchema, employeeSchema, orderPayloadSchema } = require('../validation.js');

test('Valid login schema', () => {
